<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.drivesizeviewer.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_folders"
        android:name="com.drivesizeviewer.ui.folders.FoldersFragment"
        android:label="Largest Folders"
        tools:layout="@layout/fragment_folders" />

    <fragment
        android:id="@+id/navigation_files"
        android:name="com.drivesizeviewer.ui.files.FilesFragment"
        android:label="Largest Files"
        tools:layout="@layout/fragment_files" />

    <fragment
        android:id="@+id/navigation_duplicates"
        android:name="com.drivesizeviewer.ui.duplicates.DuplicatesFragment"
        android:label="Duplicate Candidates"
        tools:layout="@layout/fragment_duplicates" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.drivesizeviewer.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
